{
  "id": "boardwalk",
  "name": "西海岸 · 破旧木板道",
  "blurb": "水闸另一侧，腐朽的木板道伸向废弃的 Feld 大楼。海风穿过断裂的栏杆，电话亭、长椅和一具倒在木板缺口旁的男性尸体留在灰白天光下。",
  "home_convs": [
    659,
    1138,
    1199,
    1222,
    1223
  ],
  "points": [
    {
      "label": "木板缺口旁的男性尸体",
      "conv": 659
    },
    {
      "label": "路边的付费电话亭",
      "conv": 1199,
      "show_when": "Variable[\"whirling.kimintro_done\"] == true"
    },
    {
      "label": "木板路上那伙人（The Pigs）",
      "conv": 1222,
      "show_when": "Variable[\"TASK.confront_the_pigs\"] == true and Variable[\"TASK.confront_the_pigs_done\"] == false",
      "done_when": "Variable[\"TASK.confront_the_pigs_done\"]"
    },
    {
      "label": "梯子边的 Trant Heidelstam",
      "conv": 1223,
      "show_when": "Variable[\"TASK.find_some_moralists\"] == true and Variable[\"TASK.find_some_moralists_done\"] == false",
      "done_when": "Variable[\"boardwalk.trant_main_hub_reached\"]"
    },
    {
      "label": "海边的长椅",
      "conv": 1138,
      "heal": {
        "morale": 1,
        "health": 1
      },
      "show_when": "(IsHourBetween(21,4)) == false"
    }
  ],
  "exits": [
    {
      "label": "穿过水闸回 Whirling-in-Rags",
      "to": "whirling_ground_floor"
    },
    {
      "label": "沿木板路去环岛",
      "to": "roundabout_jam",
      "show_when": "Variable[\"TASK.probe_drivers_about_drugs\"] == true and Variable[\"TASK.probe_drivers_about_drugs_done\"] == false"
    }
  ]
}
